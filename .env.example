# Vorlage für die lokale Konfiguration.
# Kopieren nach ".env" und dort die Werte eintragen. Die .env wird NIE committet.

# --- KI (llama-server) ---
# Adresse des llama-server (llama.cpp, OpenAI-kompatible API)
LLAMA_URL=http://127.0.0.1:8080

# Modell im llama-server (Dateiname ohne .gguf). Nur nötig, wenn der llama-server
# im Router-Modus läuft. Auf dem Mac Pro: gemma-4-26B-A4B-it-Q4_0.
# Auf einem Einzelmodell-Server kann der Name leer bleiben.
LLAMA_MODEL=

# Optionaler lokaler llama-server für die Beratung zu Tickets und freie Fragen.
# Ohne eigene Adresse verwenden diese Funktionen ebenfalls LLAMA_URL und LLAMA_MODEL.
BERATUNG_URL=
BERATUNG_MODEL=

# API-Key für den llama-server. Leer lassen, wenn der Server ohne Key läuft.
# Gibt Marlon persönlich weiter, nie ins Repo oder in Trello.
LLAMA_API_KEY=

# true  = Backend liefert Beispielantworten, kein KI-Server nötig
# false = echte Antworten vom llama-server
KI_MOCK=true

# Wie viele Sekunden das Backend höchstens auf eine KI-Antwort wartet
KI_TIMEOUT=120

# --- Ähnliche Tickets (RAG) ---
# Embedding-Server (zweiter llama-server, auf dem Mac Pro Port 8081).
# Benutzt denselben API-Key wie LLAMA_API_KEY.
EMBED_URL=http://127.0.0.1:8081

# Ab welcher Ähnlichkeit (0 bis 1) ein gelöstes Ticket als passender Fall gilt.
# Empfehlung liefert: python scripts/auswertung_rag.py --nur-suche
RAG_SCHWELLE=0.55

# Bonus für Fälle beim selben Kunden (bevorzugt laut Projektantrag)
RAG_KUNDENBONUS=0.05
# true = gelöste Fälle mit Ursache einbetten (findet gleiche Ursache bei anderen Symptomen)
RAG_MIT_URSACHE=false

# --- Backend ---
# 127.0.0.1 = nur auf diesem Rechner erreichbar. Nicht ohne Absprache ändern!
APP_HOST=127.0.0.1
APP_PORT=8000
