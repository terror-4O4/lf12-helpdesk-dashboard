# Vorlage für die lokale Konfiguration.
# Kopieren nach ".env" und dort die Werte eintragen. Die .env wird NIE committet.

# Adresse des llama-server (llama.cpp, OpenAI-kompatible API)
# Lokal:          http://127.0.0.1:8080
# Mac Pro (Team): Adresse gibt Marlon bekannt
LLAMA_URL=http://127.0.0.1:8080

# API-Key für den llama-server. Gibt Marlon persönlich weiter, nie ins Repo oder in Trello.
LLAMA_API_KEY=

# Ohne laufenden KI-Server entwickeln: true = Backend liefert Beispielantworten statt die KI zu fragen
KI_MOCK=true

# Port, auf dem das Dashboard läuft
APP_PORT=8443
